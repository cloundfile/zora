{
  "name": "@inneobr/zora",
  "version": "1.0.4",
  "description": "Assistente Pessoal de Pesquisa",
  "type": "module",
  "license": "MIT",
  "bin": {
    "zora": "./dist/zora.cjs",
    "rag": "./dist/zora.cjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/zora.cjs --alias:pdf-parse=pdf-parse/lib/pdf-parse.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "dependencies": {
    "adm-zip": "^0.5.16",
    "ollama": "^0.5.11",
    "pdf-parse": "1.1.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.3",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
